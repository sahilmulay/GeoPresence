# Copy this file to .env and fill in your Supabase project values
# (Supabase Dashboard -> Project Settings -> API)
#
# If these are left empty the app runs in DEMO MODE (data stored in the browser),
# so `npm run dev` always works.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show one-tap demo login buttons on the login page (true/false)
VITE_SHOW_DEMO_LOGINS=true
